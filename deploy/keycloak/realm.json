{
  "realm": "forgeerp",
  "enabled": true,
  "displayName": "ForgeERP",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full access (Dolibarr admin flag equivalent)" },
      { "name": "manager", "description": "Validate and manage documents" },
      { "name": "user", "description": "Standard read/write access" }
    ]
  },
  "clients": [
    {
      "clientId": "forgeerp-api",
      "name": "ForgeERP API",
      "description": "Bearer-only client validated by the Go API (FERP_OIDC_CLIENT_ID)",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "forgeerp-web",
      "name": "ForgeERP Web",
      "description": "Public SPA client for the React frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:5173/*", "http://localhost:3000/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:3000"],
      "defaultClientScopes": ["web-origins", "role_list", "profile", "roles", "email"]
    }
  ],
  "protocolMappers": []
}
